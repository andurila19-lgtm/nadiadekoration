---
// Gallery.astro - Galeri portofolio kurasi dengan filter kategori dan lightbox modal
import { galleryCategories, galleryItems } from '../data/gallery';
import { ZoomIn, X, MessageCircle } from 'lucide-astro';
---

<section class="py-14 sm:py-24 bg-ivory-100 border-b border-cream-200" id="galeri">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-14">
      <span class="inline-block text-[11px] sm:text-xs font-bold tracking-[0.24em] uppercase text-champagne-600 mb-2">
        Dokumentasi & Inspirasi
      </span>
      <h2 class="font-serif text-2xl sm:text-4xl font-medium text-olive-900 mb-3 sm:mb-4">
        Galeri Konsep Dekorasi
      </h2>
      <p class="text-xs sm:text-base text-olive-700 leading-relaxed font-light">
        Telusuri ragam inspirasi penataan pelaminan, sudut akad sakral, backdrop lamaran, dan intimate wedding. Klik pada foto untuk melihat detail atau menanyakannya langsung via WhatsApp.
      </p>
      <div class="flex items-center justify-center gap-3 mt-4">
        <div class="w-10 h-px bg-champagne-300"></div>
        <div class="w-1.5 h-1.5 rotate-45 bg-champagne-500"></div>
        <div class="w-10 h-px bg-champagne-300"></div>
      </div>
    </div>

    <!-- Filter Buttons: Horizontal swipeable on mobile, centered wrap on desktop -->
    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-3 sm:pb-0 sm:flex-wrap sm:justify-center -mx-4 px-4 sm:mx-0 sm:px-0 mb-8 sm:mb-12 scroll-smooth" role="tablist">
      {galleryCategories.map((cat, index) => (
        <button 
          type="button" 
          class={`filter-btn whitespace-nowrap flex-shrink-0 px-4 py-2 sm:px-5 sm:py-2.5 rounded-full text-xs font-semibold tracking-wider uppercase transition-all duration-200 border active:scale-95 ${
            index === 0 
              ? 'active bg-champagne-500 border-champagne-500 text-white shadow-sm' 
              : 'bg-white border-cream-300 text-olive-700 hover:border-champagne-400 hover:text-olive-900'
          }`}
          data-filter={cat.id}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6" id="galleryGrid">
      {galleryItems.map((item) => (
        <div 
          class="gallery-item group relative rounded-lg sm:rounded-xs overflow-hidden bg-white border border-cream-200 cursor-pointer shadow-subtle hover:shadow-hover hover:border-champagne-300 transition-all duration-300 active:scale-[0.99]" 
          data-id={item.id} 
          data-category={item.category}
        >
          <div class="relative h-64 sm:h-80 overflow-hidden bg-stone-100">
            <img 
              src={item.image} 
              alt={item.title} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              width="600"
              height="450"
            />
            <!-- Dark Gradient Overlay with High Readability -->
            <div class="absolute inset-0 bg-gradient-to-t from-olive-950/90 via-olive-950/30 to-transparent flex flex-col justify-end p-4 sm:p-6 text-white">
              <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                <span class="text-[9px] sm:text-[10px] font-bold tracking-widest uppercase text-champagne-300">
                  {item.categoryLabel}
                </span>
                <span class="text-[8px] sm:text-[9px] px-2 py-0.5 rounded-full bg-white/15 text-stone-200 border border-white/20">
                  {item.conceptLabel}
                </span>
              </div>
              <h3 class="font-serif text-base sm:text-lg font-medium leading-snug mb-1 text-white group-hover:text-champagne-200 transition-colors">
                {item.title}
              </h3>
              <span class="text-[11px] sm:text-xs text-stone-300">
                {item.venue}
              </span>
            </div>

            <!-- Hover Zoom Icon -->
            <div class="absolute top-3 right-3 sm:top-4 sm:right-4 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-olive-950/60 backdrop-blur-sm text-white flex items-center justify-center opacity-0 scale-75 group-hover:opacity-100 group-hover:scale-100 transition-all duration-200">
              <ZoomIn class="w-4 h-4" />
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-8 sm:mt-10 text-[11px] sm:text-xs text-olive-600 italic">
      *Foto-foto di atas disajikan sebagai demonstrasi kurasi konsep estetika dan inspirasi dekorasi pernikahan Nadia Dekorasi Madiun.
    </div>
  </div>
</section>

<!-- LIGHTBOX MODAL DIALOG -->
<div class="lightbox-modal fixed inset-0 z-50 bg-olive-950/90 backdrop-blur-md flex items-center justify-center p-3 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-300" id="lightboxModal" role="dialog" aria-modal="true" aria-labelledby="lightbox-title">
  <div class="bg-white rounded-xl sm:rounded-xs overflow-hidden max-w-4xl w-full grid grid-cols-1 md:grid-cols-12 shadow-2xl relative border border-white/20 max-h-[92vh] overflow-y-auto">
    <!-- Close Button with prominent 44px tap target -->
    <button 
      type="button" 
      id="lightboxCloseBtn"
      class="lightbox-close-btn absolute top-3 right-3 z-50 w-11 h-11 rounded-full bg-white text-olive-950 hover:bg-champagne-500 hover:text-white flex items-center justify-center transition-all cursor-pointer shadow-lg border border-cream-300 active:scale-95" 
      aria-label="Tutup Pratinjau"
    >
      <X class="w-5 h-5 pointer-events-none" />
    </button>
    
    <!-- Image Pane -->
    <div class="md:col-span-7 bg-stone-950 relative min-h-[240px] sm:min-h-[300px] md:min-h-[480px]">
      <img id="lightbox-img" src="/images/hero_pelaminan.webp" alt="Pratinjau Foto Dekorasi" class="w-full h-full object-cover" />
    </div>

    <!-- Details Pane -->
    <div class="md:col-span-5 p-5 sm:p-8 flex flex-col bg-white">
      <span class="text-[10px] sm:text-[11px] font-bold tracking-widest uppercase text-champagne-600 mb-1" id="lightbox-cat">
        Pelaminan
      </span>
      <h3 class="font-serif text-xl sm:text-2xl font-semibold text-olive-900 mb-2 sm:mb-3" id="lightbox-title">
        Judul Dekorasi
      </h3>
      <p class="text-xs sm:text-sm text-olive-700 leading-relaxed mb-4 sm:mb-5 font-light" id="lightbox-desc">
        Deskripsi rancangan dekorasi panggung pernikahan.
      </p>

      <div class="text-[11px] sm:text-xs font-bold uppercase tracking-wider text-olive-900 mb-2">
        Rincian Penataan & Dimensi:
      </div>
      <ul class="space-y-1.5 mb-5 sm:mb-6 text-xs text-olive-700" id="lightbox-details-list">
        <!-- Terisi otomatis melalui script -->
      </ul>

      <div class="text-xs text-olive-600 mt-auto pt-4 border-t border-cream-200">
        Lokasi Referensi: <strong id="lightbox-venue" class="text-olive-900 font-semibold">Madiun</strong>
      </div>

      <a 
        href="#" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="lightbox-wa-btn mt-4 w-full min-h-[46px] inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20BA59] text-white py-3.5 px-4 rounded-lg sm:rounded-xs text-xs font-semibold tracking-wider uppercase transition-colors shadow-sm active:scale-[0.98]" 
        id="lightbox-wa-link"
      >
        <MessageCircle class="w-4 h-4 text-white" />
        <span>Tanyakan Konsep Ini di WhatsApp</span>
      </a>
    </div>
  </div>
</div>
