  <div class="mobile-drawer-footer">
    <a href="https://wa.me/6282330218310?text=Halo%20Nadia%20Dekorasi%20Madiun%2C%20saya%20ingin%20konsultasi%20jadwal." 
       target="_blank" 
       rel="noopener noreferrer" 
       class="btn btn-wa" 
       style="width: 100%;">
      Hubungi WhatsApp (0823-3021-8310)
