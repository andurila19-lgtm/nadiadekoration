---
// FloatingWhatsApp.astro - Tombol aksi terapung WhatsApp dan Back-to-Top
import { MessageCircle, ArrowUp } from 'lucide-astro';
---

<!-- Floating WhatsApp Action -->
<aside aria-label="Aksi Cepat">
  <a 
    href="https://wa.me/6282330218310?text=Halo%20Nadia%20Dekorasi%20Madiun%2C%20saya%20ingin%20cek%20jadwal%20dan%20konsultasi%20dekorasi." 
    target="_blank" 
    rel="noopener noreferrer" 
    class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-40 inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20BA59] text-white p-3.5 sm:py-3 sm:px-5 rounded-full shadow-2xl transition-all duration-300 hover:scale-105 active:scale-95 group focus:outline-none" 
    aria-label="Konsultasi WhatsApp Nadia Dekorasi Madiun"
  >
    <span class="absolute inset-0 rounded-full border-2 border-[#25D366] animate-ping pointer-events-none opacity-40"></span>
    <MessageCircle class="w-6 h-6 sm:w-5 sm:h-5 text-white" />
    <span class="text-xs font-semibold tracking-wide hidden sm:inline-block">Tanya Jadwal di WhatsApp</span>
  </a>

  <!-- Back to top button -->
  <button 
    type="button" 
    class="back-to-top fixed bottom-4 left-4 sm:bottom-6 sm:left-6 z-40 w-10 h-10 rounded-full sm:rounded-xs bg-white text-olive-900 border border-cream-300 shadow-md flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 hover:bg-champagne-500 hover:text-white hover:border-champagne-500 active:scale-95" 
    aria-label="Kembali ke atas halaman"
  >
    <ArrowUp class="w-4 h-4" />
  </button>
</aside>
