---
// Packages.astro - Section daftar paket pernikahan
import { inspirationConcepts } from '../data/packages';
import PackageCard from './PackageCard.astro';
---

<section class="py-14 sm:py-24 bg-cream-100/60 border-b border-cream-200" id="paket">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-16">
      <span class="inline-block text-[11px] sm:text-xs font-bold tracking-[0.24em] uppercase text-champagne-600 mb-2">
        Konsep Inspirasi Pernikahan
      </span>
      <h2 class="font-serif text-2xl sm:text-4xl font-medium text-olive-900 mb-3 sm:mb-4">
        Inspirasi Konsep Dekorasi Pilihan
      </h2>
      <p class="text-xs sm:text-base text-olive-700 leading-relaxed font-light">
        Dirancang sebagai panduan konsep visual fleksibel (bukan paket paten kaku). Setiap elemen dapat disesuaikan sepenuhnya dengan denah lokasi, tata letak panggung, dan karakter pernikahan Anda.
      </p>
      <div class="flex items-center justify-center gap-3 mt-4">
        <div class="w-10 h-px bg-champagne-300"></div>
        <div class="w-1.5 h-1.5 rotate-45 bg-champagne-500"></div>
        <div class="w-10 h-px bg-champagne-300"></div>
      </div>
    </div>

    <!-- Package Grid: Intimate Wedding, Elegant Wedding, Floral Signature -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      {inspirationConcepts.map((pkg) => (
        <PackageCard pkg={pkg} />
      ))}
    </div>
  </div>
</section>
