---
// Navbar.astro - Header navigasi premium multi-page dengan sticky blur & mobile drawer
import { MessageCircle, Menu, X, ArrowRight } from 'lucide-astro';
import { businessNavigation } from '../data/business';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';
---

<!-- Pratinjau Konsep Banner -->
<div class="bg-olive-950 text-stone-300 text-xs py-2 px-3 sm:px-6 border-b border-white/10 relative z-50" id="conceptBanner">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-2 sm:gap-3">
    <!-- Left badge & text -->
    <div class="flex items-center gap-2 min-w-0">
      <span class="inline-flex items-center gap-1 bg-champagne-500/20 text-champagne-300 border border-champagne-500/30 text-[10px] sm:text-[11px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-xs flex-shrink-0">
        Pratinjau
      </span>
      <span class="text-stone-300 text-[11px] sm:text-xs truncate sm:whitespace-normal">
        <span class="hidden sm:inline">Konsep website bisnis resmi untuk </span><strong>Nadia Dekorasi Madiun</strong><span class="hidden md:inline"> — Pratinjau pengalaman calon pengantin & vendor.</span>
      </span>
    </div>

    <!-- Right link & close -->
    <div class="flex items-center gap-2 sm:gap-4 text-[11px] sm:text-xs flex-shrink-0">
      <a href="/kontak" class="text-champagne-300 hover:text-white underline underline-offset-4 font-medium transition-colors flex items-center gap-1 whitespace-nowrap">
        <span>Form WhatsApp</span>
        <ArrowRight class="w-3 h-3" />
      </a>
      <button 
        type="button" 
        class="banner-close-btn w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center rounded-full text-stone-400 hover:text-white hover:bg-white/10 text-lg leading-none active:scale-95 transition-all" 
        aria-label="Tutup Banner"
      >
        &times;
      </button>
    </div>
  </div>
</div>

<!-- Header Utama -->
<header class="site-header sticky top-0 w-full bg-ivory-100/95 backdrop-blur-md border-b border-cream-200 z-40 transition-all duration-300 shadow-xs" id="siteHeader">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 flex items-center justify-between h-16 sm:h-20">
    <!-- Brand Logo Wordmark -->
    <a href="/" class="group flex flex-col focus:outline-none" aria-label="Nadia Dekorasi Madiun Beranda">
      <span class="font-serif text-lg sm:text-2xl font-bold tracking-[0.12em] sm:tracking-[0.14em] text-olive-900 uppercase leading-none group-hover:text-champagne-600 transition-colors">
        NADIA DEKORASI
      </span>
      <span class="text-[8px] sm:text-[10px] tracking-[0.2em] sm:tracking-[0.24em] uppercase text-sage-600 font-semibold mt-1">
        WEDDING DECORATION • MADIUN RAYA
      </span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden lg:flex items-center space-x-7" aria-label="Navigasi Utama">
      {businessNavigation.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a 
            href={link.href} 
            class={`nav-link text-sm font-medium tracking-wide transition-colors py-1 relative ${
              isActive 
                ? 'text-olive-950 font-semibold border-b-2 border-champagne-500' 
                : 'text-olive-700 hover:text-olive-950'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Header CTA WhatsApp & Mobile Toggle -->
    <div class="flex items-center space-x-2 sm:space-x-3">
      <a 
        href="https://wa.me/6282330218310?text=Halo%20Nadia%20Dekorasi%20Madiun%2C%20saya%20ingin%20berkonsultasi%20mengenai%20dekorasi%20pernikahan." 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hidden sm:inline-flex items-center gap-2 bg-sage-600 hover:bg-sage-700 text-white px-5 py-2.5 rounded-xs text-xs font-semibold tracking-wider uppercase shadow-sm transition-all duration-200 hover:-translate-y-0.5 active:scale-95"
        aria-label="Konsultasi via WhatsApp"
      >
        <MessageCircle class="w-4 h-4 text-white" />
        <span>Konsultasi WhatsApp</span>
      </a>

      <!-- Mobile Hamburger Button with comfortable 44px tap target -->
      <button 
        type="button" 
        class="mobile-nav-toggle lg:hidden w-11 h-11 flex items-center justify-center p-2 text-olive-900 hover:text-champagne-600 border border-cream-300 rounded-md bg-white/70 active:bg-cream-100 focus:outline-none transition-colors" 
        aria-label="Buka Menu Navigasi" 
        aria-expanded="false"
      >
        <Menu class="w-5 h-5" />
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-nav-drawer fixed inset-y-0 right-0 w-[84%] max-w-sm bg-ivory-100 z-50 p-6 flex flex-col shadow-2xl transition-all duration-300 ease-in-out" id="mobileDrawer">
  <div class="flex items-center justify-between pb-4 border-b border-cream-200 mb-6">
    <div>
      <span class="font-serif text-lg font-bold tracking-wider text-olive-900 block leading-none">
        NADIA DEKORASI
      </span>
      <span class="text-[9px] tracking-widest text-sage-600 font-semibold block mt-1">
        MADIUN • PONOROGO • MAGETAN • NGAWI
      </span>
    </div>
    <button type="button" class="mobile-drawer-close w-10 h-10 flex items-center justify-center text-olive-900 hover:text-champagne-600 rounded-full hover:bg-cream-200 active:scale-95 transition-all" aria-label="Tutup Menu">
      <X class="w-5 h-5" />
    </button>
  </div>

  <nav class="flex flex-col space-y-3" aria-label="Navigasi Mobile">
    {businessNavigation.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a 
          href={link.href} 
          class={`mobile-nav-link font-serif text-lg py-2.5 px-3 rounded-lg flex items-center justify-between transition-colors ${
            isActive 
              ? 'bg-champagne-500/10 text-champagne-600 font-semibold border-l-4 border-champagne-500' 
              : 'text-olive-900 hover:bg-cream-200/50'
          }`}
        >
          <span>{link.name}</span>
          <ArrowRight class="w-4 h-4 opacity-40" />
        </a>
      );
    })}
  </nav>

  <div class="mt-auto pt-6 border-t border-cream-200">
    <a 
      href="https://wa.me/6282330218310?text=Halo%20Nadia%20Dekorasi%20Madiun%2C%20saya%20ingin%20konsultasi%20jadwal." 
      target="_blank" 
      rel="noopener noreferrer" 
      class="w-full inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20BA59] text-white py-3.5 px-4 rounded-lg text-sm font-semibold tracking-wide shadow-md active:scale-95 transition-all"
    >
      <MessageCircle class="w-5 h-5 text-white" />
      <span>Hubungi WhatsApp Resmi</span>
    </a>
    <p class="text-[11px] text-olive-600 text-center mt-3">
      Instagram: <a href="https://www.instagram.com/nadia_dekorasi.madiun/" target="_blank" rel="noopener noreferrer" class="underline hover:text-olive-900 font-medium">@nadia_dekorasi.madiun</a>
    </p>
  </div>
</div>

<!-- Backdrop Overlay -->
<div class="mobile-drawer-overlay fixed inset-0 bg-olive-950/60 backdrop-blur-xs z-40 opacity-0 pointer-events-none transition-opacity duration-300"></div>
