---
// Hero.astro - Full-width wedding stage photography hero section
import { MessageCircle, MapPin, ArrowRight } from 'lucide-astro';
---

<section class="relative min-h-[85vh] sm:min-h-[90vh] flex items-center bg-olive-950 text-white overflow-hidden" id="beranda">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/hero_pelaminan.webp" 
      alt="Dekorasi Panggung Pelaminan Mewah Nadia Dekorasi Madiun" 
      class="w-full h-full object-cover object-[center_35%] scale-100 hover:scale-105 transition-transform duration-[12000ms] ease-out" 
      loading="eager"
      width="1920"
      height="1080"
    />
    <!-- Rich Editorial Gradient Overlay for Perfect Contrast -->
    <div class="absolute inset-0 bg-gradient-to-t from-olive-950 via-olive-950/80 to-olive-950/45"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-8 py-14 sm:py-32 w-full">
    <div class="max-w-3xl">
      <!-- Tag / Category Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-champagne-300 text-[10px] sm:text-xs font-semibold tracking-widest uppercase mb-4 sm:mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-champagne-300"></span>
        <span>WEDDING DECORATION • MADIUN</span>
      </div>

      <!-- Headline -->
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-medium tracking-tight text-white leading-[1.2] mb-4 sm:mb-6 drop-shadow-md">
        Wujudkan Pernikahan Impian dalam <span class="italic font-normal text-champagne-300">Dekorasi yang Berkesan</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-sm sm:text-lg text-stone-200/90 leading-relaxed font-light mb-8 sm:mb-10 max-w-2xl drop-shadow">
        Menghadirkan keindahan panggung pelaminan, tata ruang akad nikah yang syahdu, serta backdrop custom bernilai estetika tinggi dengan konsep personal untuk hari paling membahagiakan Anda di Madiun dan sekitarnya.
      </p>

      <!-- Primary Conversion CTAs: Full-width on mobile with comfortable touch targets -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 mb-10 sm:mb-14 w-full">
        <a 
          href="#paket" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-champagne-500 hover:bg-champagne-600 active:bg-champagne-700 text-white px-7 py-3.5 sm:py-4 rounded-lg sm:rounded-xs text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all duration-200 active:scale-[0.98] shadow-lg shadow-champagne-500/25"
        >
          <span>Lihat Paket Dekorasi</span>
          <ArrowRight class="w-4 h-4" />
        </a>

        <a 
          href="https://wa.me/6282330218310?text=Halo%20Nadia%20Dekorasi%20Madiun%2C%20saya%20ingin%20berkonsultasi%20mengenai%20rencana%20dekorasi%20pernikahan%20saya." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-white/10 hover:bg-white/20 active:bg-white/30 text-white border border-white/30 backdrop-blur-sm px-7 py-3.5 sm:py-4 rounded-lg sm:rounded-xs text-xs sm:text-sm font-semibold tracking-wider uppercase transition-all duration-200 active:scale-[0.98]"
        >
          <MessageCircle class="w-4 h-4 text-[#25D366]" />
          <span>Konsultasi via WhatsApp</span>
        </a>
      </div>

      <!-- Regional Coverage Badges -->
      <div class="pt-6 sm:pt-8 border-t border-white/15 flex flex-col sm:flex-row sm:items-center gap-3 text-xs text-stone-300">
        <span class="font-medium text-white flex items-center gap-1.5 uppercase tracking-wider text-[11px] sm:text-xs">
          <MapPin class="w-3.5 h-3.5 text-champagne-300 flex-shrink-0" />
          Wilayah Layanan:
        </span>
        <div class="flex flex-wrap gap-1.5 sm:gap-2">
          <span class="px-2.5 py-1 rounded-full bg-white/10 border border-white/15 text-stone-200 text-[11px] sm:text-xs">Kota Madiun</span>
          <span class="px-2.5 py-1 rounded-full bg-white/10 border border-white/15 text-stone-200 text-[11px] sm:text-xs">Kabupaten Madiun</span>
          <span class="px-2.5 py-1 rounded-full bg-white/10 border border-white/15 text-stone-200 text-[11px] sm:text-xs">Ponorogo</span>
          <span class="px-2.5 py-1 rounded-full bg-white/10 border border-white/15 text-stone-200 text-[11px] sm:text-xs">Magetan</span>
          <span class="px-2.5 py-1 rounded-full bg-white/10 border border-white/15 text-stone-200 text-[11px] sm:text-xs">Ngawi</span>
        </div>
      </div>
    </div>
  </div>
</section>
