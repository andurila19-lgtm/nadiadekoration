---
// src/pages/index.astro - Halaman Utama Nadia Dekorasi Madiun
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Packages from '../components/Packages.astro';
import Gallery from '../components/Gallery.astro';
import Services from '../components/Services.astro';
import InquiryForm from '../components/InquiryForm.astro';
import WhyUs from '../components/WhyUs.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
---

<BaseLayout 
  title="Nadia Dekorasi Madiun | Dekorasi Pernikahan Custom"
  description="Vendor dekorasi pernikahan independen di Madiun Raya. Melayani dekorasi pelaminan modern & tradisional, akad nikah sakral, backdrop custom, pernikahan rumahan, dan sewa perlengkapan di Madiun, Ponorogo, Magetan, dan Ngawi."
>
  <!-- Navigation Header & Concept Preview -->
  <Navbar />

  <!-- Main Content Flow -->
  <main id="main-content">
    <Hero />
    <Intro />
    <Packages />
    <Gallery />
    <Services />
    <InquiryForm />
    <WhyUs />
    <CTA />
  </main>

  <!-- Footer -->
  <Footer />

  <!-- Floating Actions (WhatsApp & Back-to-Top) -->
  <FloatingWhatsApp />
</BaseLayout>
